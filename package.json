{
  "name": "reflex-monorepo",
  "private": true,
  "version": "0.7.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm build:product",
    "test": "pnpm test:product",
    "test:e2e:runtime": "pnpm --filter @volynets/reflex-runtime test:e2e",
    "bench": "pnpm -r bench",
    "bench:runtime": "pnpm --filter @volynets/reflex-runtime bench:runtime",
    "bench:runtime:json": "node tooling/benchmarks/collect.mjs",
    "bench:tracking-factorial": "pnpm --filter @volynets/reflex-runtime build:ts && pnpm --filter @volynets/reflex-runtime exec rollup --silent -c rollup.tracking-factorial.config.ts --configPlugin @rollup/plugin-swc && node scripts/compare-tracking-tiers-factorial.mjs",
    "bench:tracking-tier-profile": "pnpm --filter @volynets/reflex-runtime build:ts && pnpm --filter @volynets/reflex-runtime exec rollup --silent -c rollup.tracking-tier-profile.config.ts --configPlugin @rollup/plugin-swc && node scripts/profile-tracking-tier-substitution.mjs",
    "bench:compare": "node tooling/benchmarks/compare.mjs",
    "bench:quality-gate": "node tooling/benchmarks/quality-gate.mjs",
    "bench:history": "node tooling/benchmarks/history.mjs",
    "qualify:stages": "node scripts/qualify-stages.mjs",
    "lint": "node tooling/configs/lint.mjs",
    "lint:fix": "node tooling/configs/lint.mjs --fix",
    "typecheck": "node tooling/build/run.mjs --scope product typecheck",
    "typecheck:differential": "pnpm --filter @volynets/reflex-runtime typecheck:differential",
    "release": "pnpm release:qualify",
    "prepare": "husky",
    "build:product": "node tooling/build/run.mjs --scope product build",
    "build:tools": "node tooling/build/run.mjs --scope tools build",
    "build:research": "node tooling/build/run.mjs --scope research build",
    "build:apps": "node tooling/build/run.mjs --scope apps build",
    "build:workspace": "node tooling/build/run.mjs --scope all build",
    "qualify": "node tooling/testing/qualify.mjs",
    "test:consumer": "node tooling/testing/qualify.mjs",
    "check:artifacts": "node tooling/build/verify-artifacts.mjs",
    "check:active-divergences": "node tooling/testing/check-active-divergences.mjs",
    "quality:check": "node tooling/configs/run-checks.mjs",
    "quality:registry": "node tooling/configs/run-checks.mjs --list",
    "quality:aggregate": "node tooling/configs/aggregate-checks.mjs",
    "check:configs": "node tooling/configs/check-equivalence.mjs",
    "test:projects": "vitest run --config vitest.config.ts",
    "release:version": "changeset version",
    "release:qualify": "pnpm quality:check && pnpm qualify",
    "release:publish": "node tooling/configs/publish-qualified.mjs --publish",
    "test:product": "node tooling/build/run.mjs --scope product test",
    "test:research": "node tooling/build/run.mjs --scope research test",
    "typecheck:tools": "node tooling/build/run.mjs --scope tools typecheck",
    "typecheck:research": "node tooling/build/run.mjs --scope research typecheck",
    "test:bench-tools": "node --test tooling/benchmarks/benchmarks.test.mjs",
    "check:research": "node tooling/benchmarks/verify-research.mjs --manifest experiments/artifacts.manifest.json",
    "test:build-tooling": "node --test tooling/build/verify-artifacts.test.mjs",
    "test:tooling": "node tooling/build/test-tooling.mjs"
  },
  "devDependencies": {
    "0x": "^6.0.0",
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-swc": "^0.4.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@swc/core": "^1.15.18",
    "@vitest/coverage-v8": "^4.0.9",
    "eslint": "^9.0.0",
    "fast-check": "^4.3.0",
    "husky": "^9.0.0",
    "jsdom": "^29.0.1",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "rollup": "^4.54.0",
    "rollup-plugin-const-enum": "^1.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "rollup-plugin-dts": "^6.4.1"
  }
}
