{
  "name": "@volynets/reflex-scheduler",
  "version": "0.1.0",
  "type": "module",
  "description": "Effect scheduler policies for Reflex runtimes",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ../../tooling/build/clean.mjs .",
    "build": "pnpm clean && node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json && node ../../scripts/fix-esm-specifiers.mjs dist && node scripts/finalize-modules.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "bench": "vitest bench",
    "bench:full-graph": "vitest bench bench/full-graph.bench.ts",
    "bench:hot-path": "vitest bench bench/hot-path.bench.ts",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.typecheck.json",
    "build:all": "node ../../tooling/build/run.mjs @volynets/reflex-scheduler",
    "check:artifacts": "node ../../tooling/build/verify-artifacts.mjs --directory .",
    "prepack": "pnpm check:artifacts",
    "prepublishOnly": "pnpm typecheck && pnpm check:artifacts"
  },
  "peerDependencies": {
    "@volynets/reflex-runtime": "^1.0.0"
  },
  "devDependencies": {
    "@volynets/reflex-runtime": "workspace:*"
  },
  "private": false
}
