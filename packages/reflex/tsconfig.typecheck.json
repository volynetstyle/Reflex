{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@runtime/*": ["../reflex-runtime/src/*"],
      "@reflex/runtime": [
        "../@reflex/runtime/src/index.ts",
        "../@reflex/runtime/dist/globals.d.ts"
      ],
      "@volynets/reflex-runtime/debug": [
        "../reflex-runtime/debug/index.ts",
        "../reflex-runtime/dist/esm/debug/index.d.ts"
      ],
      "@volynets/reflex-runtime/internal": [
        "../reflex-runtime/src/internal/index.ts",
        "../reflex-runtime/dist/esm/internal/index.d.ts"
      ]
    }
  },
  "include": ["src", "../reflex-runtime/src/globals.d.ts"]
}
