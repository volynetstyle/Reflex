{
  "name": "@volynets/reflex-runtime-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "Official MCP protocol boundary for Reflex runtime diagnostics.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "reflex-runtime-mcp": "dist/entrypoint.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json && node scripts/finalize-cli.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "pnpm build:all && pnpm test",
    "clean": "node ../../tooling/build/clean.mjs .",
    "build:all": "node ../../tooling/build/run.mjs @volynets/reflex-runtime-mcp",
    "check:artifacts": "node ../../tooling/build/verify-artifacts.mjs --directory .",
    "prepack": "pnpm check:artifacts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm check:artifacts",
    "test": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@volynets/reflex-runtime": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
