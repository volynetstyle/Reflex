{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@volynets/reflex-runtime": [
        "../reflex-runtime/src/index.ts"
      ],
      "@volynets/reflex-runtime/internal": [
        "../reflex-runtime/src/internal/index.ts"
      ],
      "@runtime/*": ["../reflex-runtime/src/*"]
    },
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "../reflex-runtime/src/globals.d.ts"
  ]
}
