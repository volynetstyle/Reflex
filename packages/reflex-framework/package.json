{
  "name": "@volynets/reflex-framework",
  "version": "0.1.3",
  "type": "module",
  "description": "Platform-agnostic JSX runtime and renderable model for Reflex",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "source": {
        "types": "./src/jsx-runtime.ts",
        "default": "./src/jsx-runtime.ts"
      },
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "source": {
        "types": "./src/jsx-dev-runtime.ts",
        "default": "./src/jsx-dev-runtime.ts"
      },
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ../../tooling/build/clean.mjs .",
    "build": "node ./scripts/clean.mjs && node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json && node ../../scripts/fix-esm-specifiers.mjs dist && node ./scripts/ensure-disposable-reference.mjs && node ./scripts/finalize-modules.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm exec vitest run --config vite.config.ts && pnpm test:dev",
    "test:dev": "pnpm exec vitest run --config vite.lifecycle.dev.config.ts",
    "bench": "pnpm exec vitest bench --config vite.config.ts",
    "bench:ownership": "pnpm exec vitest bench bench/ownership.bench.ts --config vite.config.ts",
    "bench:ui": "pnpm exec vitest bench bench/ui-scenarios.bench.ts --config vite.config.ts",
    "build:dashboard": "pnpm --dir examples/build-dashboard build",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.typecheck.json",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm typecheck && pnpm check:artifacts",
    "build:all": "node ../../tooling/build/run.mjs @volynets/reflex-framework",
    "check:artifacts": "node ../../tooling/build/verify-artifacts.mjs --directory .",
    "prepack": "pnpm check:artifacts"
  },
  "keywords": [
    "jsx",
    "reactivity",
    "renderer",
    "runtime",
    "reflex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volynetstyle/Reflex.git",
    "directory": "packages/reflex-framework"
  },
  "homepage": "https://github.com/volynetstyle/Reflex/tree/main/packages/reflex-framework",
  "bugs": {
    "url": "https://github.com/volynetstyle/Reflex/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "@volynets/reflex-runtime": "^1.0.0"
  },
  "devDependencies": {
    "@volynets/reflex-runtime": "workspace:*"
  },
  "private": false
}
