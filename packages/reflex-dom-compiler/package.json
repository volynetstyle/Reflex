{
  "name": "@volynets/reflex-dom-compiler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Experimental compiler that lowers static Reflex JSX regions to native DOM operations",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts"
  },
  "scripts": {
    "test": "vitest run --config vite.config.ts",
    "test:browser": "vitest run --config vite.browser.config.ts",
    "bench": "node bench/run-ts.mjs bench/run.ts",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "26.1.2",
    "@vitest/browser-playwright": "4.1.5",
    "@volynets/reflex-dom": "workspace:*",
    "@volynets/reflex-framework": "workspace:*",
    "@volynets/reflex-runtime": "workspace:*",
    "@volynets/reflex-scheduler": "workspace:*",
    "esbuild": "0.25.12",
    "playwright": "^1.62.1"
  }
}
