{
  "name": "@volynets/reflex-runtime",
  "version": "1.2.1",
  "type": "module",
  "description": "Low-level reactive runtime for deterministic dependency tracking and push/pull propagation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volynetstyle/Reflex.git",
    "directory": "packages/reflex-runtime"
  },
  "author": "Andrii Volynets",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/src/index.d.ts",
        "development": "./dist/dev/index.js",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/types/src/index.d.cts",
        "development": "./dist/cjs-dev/index.cjs",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./debug": {
      "import": {
        "types": "./dist/esm/debug/index.d.ts",
        "default": "./dist/dev/debug.js"
      },
      "require": {
        "types": "./dist/cjs/types/debug/index.d.cts",
        "default": "./dist/cjs-dev/debug.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/esm/src/internal/index.d.ts",
        "development": "./dist/dev/internal.js",
        "default": "./dist/esm/internal.js"
      },
      "require": {
        "types": "./dist/cjs/types/src/internal/index.d.cts",
        "development": "./dist/cjs-dev/internal.cjs",
        "default": "./dist/cjs/internal.cjs"
      }
    }
  },
  "files": [
    "dist/cjs",
    "dist/cjs-dev",
    "dist/dev",
    "dist/esm",
    "dist/index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ../../tooling/build/clean.mjs .",
    "build:ts": "tsc -p tsconfig.build.json && node scripts/rewrite-build-aliases.mjs && node ../../scripts/write-index-dts.mjs .",
    "build:npm": "rollup --silent -c config/rollup.config.ts --configPlugin @rollup/plugin-swc",
    "build:perf": "rollup --silent -c config/rollup.config.ts --configPlugin @rollup/plugin-swc --configTarget perf",
    "build": "pnpm clean && pnpm build:ts && pnpm build:npm && pnpm build:types:cjs && pnpm check:projection-erasure && pnpm check:identity",
    "check:projection-erasure": "node scripts/check-production-projection-erasure.mjs",
    "bench:core": "pnpm build:perf && node --expose-gc dist/perf.js",
    "perf:tree": "pnpm build:ts && pnpm build:perf && node --expose-gc dist/perf-tree.js",
    "test": "vitest run --config config/vitest.config.ts",
    "rt": "node testkit/cli.mjs",
    "test:testkit": "node testkit/cli.mjs run self",
    "test:projection": "vitest run --config config/vitest.config.ts --mode projection",
    "test:coverage": "vitest run --config config/vitest.config.ts --coverage",
    "test:dev": "vitest run --config config/vitest.config.ts --mode dev",
    "check:architecture": "node scripts/check-architecture-contract.mjs",
    "check:rules": "node scripts/check-rules-citations.mjs",
    "check:bundle-identity": "node scripts/check-bundle-identity.mjs",
    "pretest:e2e": "pnpm build",
    "test:e2e": "node test/mjs/runtime.e2e.mjs",
    "bench:runtime": "vitest bench --config config/vitest.config.ts test/perf/runtime-taxonomy.bench.ts",
    "bench:runtime:json": "vitest bench --config config/vitest.config.ts test/perf/runtime-taxonomy.bench.ts --outputJson ../../bench-results/runtime/latest.raw.json",
    "bench:runtime:memory": "pnpm build:ts && pnpm build:perf && node --expose-gc perf/callback-memory/run.mjs",
    "bench:domains": "vitest bench --config config/vitest.config.ts test/perf/domain-boundary.bench.ts --run",
    "check:domain-retention": "node --expose-gc perf/domain-retention/run.mjs && node --expose-gc --conditions=development perf/domain-retention/run.mjs",
    "bench:push-pull": "vitest bench --config config/vitest.config.ts --mode dev test/perf/push-pull-components.bench.ts",
    "bench:pull-wide": "vitest bench --config config/vitest.config.ts test/perf/pull-wide.bench.ts",
    "bench:cost-attribution:structural": "vitest run --config config/vitest.config.ts --mode cost-attribution-structural",
    "bench:cost-attribution:timing": "vitest run --config config/vitest.config.ts --mode cost-attribution-timing",
    "bench:cost-attribution:analyze": "node perf/cost-attribution/analyze.mjs",
    "bench:cost-attribution": "pnpm bench:cost-attribution:structural && pnpm bench:cost-attribution:timing && pnpm bench:cost-attribution:analyze",
    "bench:work-amplification:sweep": "vitest run --config config/vitest.config.ts --mode work-amplification",
    "bench:work-amplification:analyze": "node perf/work-amplification/analyze.mjs",
    "bench:work-amplification": "pnpm bench:work-amplification:sweep && pnpm bench:work-amplification:analyze",
    "bench:lifetime-churn": "vitest run --config config/vitest.config.ts --mode lifetime-churn",
    "test:watch": "vitest --config config/vitest.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit && pnpm typecheck:differential",
    "typecheck:differential": "tsc --noEmit -p test/differential/tsconfig.json",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm typecheck && pnpm check:architecture && pnpm check:artifacts",
    "release": "changeset version && pnpm install && changeset publish",
    "check:identity": "node scripts/check-module-identity.mjs",
    "build:all": "node ../../tooling/build/run.mjs @volynets/reflex-runtime",
    "check:artifacts": "node ../../tooling/build/verify-artifacts.mjs --directory .",
    "prepack": "pnpm check:artifacts",
    "build:types:cjs": "node ../../tooling/build/cjs-declarations.mjs . runtime",
    "check:domain-baseline": "node scripts/record-domain-baseline.mjs --check",
    "record:domain-baseline": "node scripts/record-domain-baseline.mjs",
    "build:tracking-factorial": "rollup --silent -c config/rollup.config.ts --configPlugin @rollup/plugin-swc --configTarget tracking-factorial",
    "build:tracking-tier-profile": "rollup --silent -c config/rollup.config.ts --configPlugin @rollup/plugin-swc --configTarget tracking-tier-profile"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@volynets/algorithm-projection": "workspace:*",
    "typescript": "^5.6.0"
  },
  "private": false
}
