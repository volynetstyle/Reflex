{
  "name": "@volynets/reflex-runtime",
  "version": "1.0.0",
  "type": "module",
  "description": "Low-level reactive runtime for deterministic dependency tracking and push/pull propagation.",
  "license": "MIT",
  "author": "Andrii Volynets",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/src/index.d.ts",
      "import": {
        "development": "./dist/dev/index.js",
        "default": "./dist/esm/index.js"
      },
      "require": "./dist/cjs/index.cjs"
    },
    "./debug": {
      "types": "./dist/esm/debug/index.d.ts",
      "import": "./dist/dev/debug.js"
    },
    "./internal": {
      "types": "./dist/esm/src/internal/index.d.ts",
      "import": {
        "development": "./dist/dev/internal.js",
        "default": "./dist/esm/internal.js"
      },
      "require": "./dist/cjs/internal.cjs"
    }
  },
  "files": [
    "dist/cjs",
    "dist/dev",
    "dist/esm",
    "dist/index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true});require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "vite",
    "build:ts": "tsc -p tsconfig.build.json && node scripts/rewrite-build-aliases.mjs && node ../../scripts/write-index-dts.mjs .",
    "build:npm": "rollup --silent -c rollup.config.ts --configPlugin @rollup/plugin-swc",
    "build:perf": "rollup --silent -c rollup.perf.config.ts --configPlugin @rollup/plugin-swc",
    "build": "pnpm clean && pnpm build:ts && pnpm build:npm",
    "example:introspection": "pnpm build && node examples/introspection.phases.mjs",
    "bench:core": "pnpm build:perf && node --expose-gc dist/perf.js",
    "perf:tree": "pnpm build:ts && pnpm build:perf && node --expose-gc dist/perf-tree.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:dev": "vitest run --config vite.dev.config.ts",
    "check:architecture": "node scripts/check-architecture-contract.mjs",
    "pretest:e2e": "pnpm build",
    "test:e2e": "node test/mjs/runtime.e2e.mjs",
    "bench": "pnpm build && vitest bench test/signal_beta.bench.ts",
    "bench:runtime": "vitest bench test/perf/runtime-taxonomy.bench.ts",
    "bench:runtime:json": "vitest bench test/perf/runtime-taxonomy.bench.ts --outputJson ../../bench-results/runtime/latest.raw.json",
    "bench:runtime:memory": "pnpm build:ts && pnpm build:perf && node --expose-gc perf/callback-memory/run.mjs",
    "bench:runtime:memory:json": "pnpm build:ts && pnpm build:perf && node --expose-gc perf/callback-memory/run.mjs --json",
    "bench:push-pull": "vitest bench --config vite.dev.config.ts test/perf/push-pull-components.bench.ts",
    "bench:taxonomy": "pnpm bench:runtime",
    "bench:cost-attribution:structural": "vitest run --config vite.cost-attribution.structural.config.ts",
    "bench:cost-attribution:timing": "vitest run --config vite.cost-attribution.timing.config.ts",
    "bench:cost-attribution:analyze": "node perf/cost-attribution/analyze.mjs",
    "bench:cost-attribution": "pnpm bench:cost-attribution:structural && pnpm bench:cost-attribution:timing && pnpm bench:cost-attribution:analyze",
    "bench:work-amplification:sweep": "vitest run --config vite.work-amplification.config.ts",
    "bench:work-amplification:analyze": "node perf/work-amplification/analyze.mjs",
    "bench:work-amplification": "pnpm bench:work-amplification:sweep && pnpm bench:work-amplification:analyze",
    "bench:flame": "0x -- node dist/tests/ownership.run.js",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm typecheck && pnpm build && pnpm check:architecture",
    "release": "changeset version && pnpm install && changeset publish"
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  }
}
