{
  "name": "@volynets/reflex-dom",
  "version": "1.0.0",
  "type": "module",
  "description": "DOM renderer for Reflex",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "source": {
        "types": "./src/jsx-runtime.ts",
        "default": "./src/jsx-runtime.ts"
      },
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "source": {
        "types": "./src/jsx-dev-runtime.ts",
        "default": "./src/jsx-dev-runtime.ts"
      },
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./standalone": {
      "types": "./dist/standalone/index.d.ts",
      "import": "./dist/standalone/index.js"
    },
    "./standalone/jsx-runtime": {
      "types": "./dist/standalone/jsx-runtime.d.ts",
      "import": "./dist/standalone/jsx-runtime.js"
    },
    "./standalone/jsx-dev-runtime": {
      "types": "./dist/standalone/jsx-dev-runtime.d.ts",
      "import": "./dist/standalone/jsx-dev-runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": false
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true});require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:dependencies": "pnpm --filter @volynets/reflex-runtime build && pnpm --filter @volynets/reflex-scheduler build && pnpm --filter @volynets/reflex-framework build",
    "build:modules": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json && node ../../scripts/fix-esm-specifiers.mjs build/esm",
    "build:bundle": "rollup --silent -c rollup.config.ts --configPlugin @rollup/plugin-swc && node ./scripts/finalize-package.mjs",
    "build": "pnpm clean && pnpm build:dependencies && pnpm build:modules && pnpm build:bundle && pnpm test:standalone",
    "bench:keyed": "vitest bench --config vite.config.ts bench/keyed-reconciliation.bench.ts",
    "bench:boundary": "vitest bench --config vite.config.ts bench/scheduler-boundary.bench.ts --run",
    "bench:range": "vitest bench --config vite.config.ts bench/range-handle.bench.ts --run",
    "bench:mutations": "powershell -NoProfile -ExecutionPolicy Bypass -File ./bench/run-mutations.ps1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm exec vitest run --config vite.config.ts",
    "test:browser": "vitest run --config vite.browser.config.ts",
    "test:standalone": "node scripts/check-standalone.mjs",
    "prepack": "pnpm build",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.typecheck.json",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm typecheck",
    "test:library": "pnpm --filter @volynets/reflex build:all && pnpm --filter @volynets/reflex-store build && node scripts/check-library.mjs"
  },
  "keywords": [
    "dom",
    "jsx",
    "reactivity",
    "renderer",
    "reflex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volynetstyle/Reflex.git",
    "directory": "packages/reflex-dom"
  },
  "homepage": "https://github.com/volynetstyle/Reflex/tree/main/packages/reflex-dom",
  "bugs": {
    "url": "https://github.com/volynetstyle/Reflex/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "4.1.5",
    "@volynets/reflex-framework": "workspace:*",
    "@volynets/reflex-runtime": "workspace:*",
    "@volynets/reflex-scheduler": "workspace:*",
    "playwright": "^1.62.1"
  },
  "peerDependencies": {
    "@volynets/reflex-runtime": "^1.0.0",
    "@volynets/reflex-framework": "^0.1.3",
    "@volynets/reflex-scheduler": "^0.1.0"
  }
}
